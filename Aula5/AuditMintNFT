pragma solidity ^0.8.26;


contract AuditMintNFT {
    string public name = "AuditMintNFT";
    string public symbol = "AMN";

    address public owner;
    bool public initialized;

    uint256 public mintPrice = 0.01 ether;
    bool public paused;

    // "NFT" minimalista (não é ERC721 completo)
    mapping(uint256 => address) public ownerOf;
    mapping(address => uint256) public balanceOf;

    
    address payable[] public buyers;

    event OwnerChanged(address indexed oldOwner, address indexed newOwner);
    event Paused(bool paused);
    event Mint(address indexed to, uint256 indexed tokenId, uint256 paid);
    event Refund(address indexed to, uint256 amount);

  
    modifier onlyOwner() {
        require(tx.origin == owner, "not owner"); 
        _;
    }

    modifier notPaused() {
        require(!paused, "paused");
        _;
    }

    
    function initialize(address _owner) external {
        require(!initialized, "already initialized");
        owner = _owner;
        emit OwnerChanged(address(0), _owner);
       
    }

    function setPaused(bool _paused) external onlyOwner {
        paused = _paused;
        emit Paused(_paused);
    }

    function setMintPrice(uint256 newPrice) external onlyOwner {
        mintPrice = newPrice;
    }

  
    function mint(address to, uint256 tokenId) external payable notPaused {
        require(msg.value >= mintPrice, "pay more");

      
        ownerOf[tokenId] = to;
        balanceOf[to] += 1;

        buyers.push(payable(msg.sender)); 

        emit Mint(to, tokenId, msg.value);
    }

 
    function refundAll() external onlyOwner {
        uint256 price = mintPrice;

        for (uint256 i = 0; i < buyers.length; i++) {
         
            buyers[i].transfer(price); 
            emit Refund(buyers[i], price);
        }
    }


    function buyersCount() external view returns (uint256) {
        return buyers.length;
    }


    receive() external payable {}
}
